{
	"name": "orpheus-mcp",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "",
	"license": "GPL-3.0-or-later",
	"author": "Tenebrie",
	"scripts": {
		"tsc": "tsc --noEmit",
		"build": "tsc -p . && tsc-alias -p tsconfig.json",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"prod": "node dist/index.js",
		"start": "nodemon --watch src $(node /scripts/prepare-library-deps-list.mjs) --ext ts,js,json --ignore 'src/**/*.spec.ts' --exec 'tsx src/index.ts' --delay 0.1s",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"inspector": "npx @modelcontextprotocol/inspector"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@neverkin/esoteric-date": "file:../../library/esoteric-date",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/ws": "^8.5.10",
		"chalk": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"openapi-fetch": "^0.17.0",
		"redis": "^6.2.1",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@modelcontextprotocol/inspector": "^2.4.0",
		"@neverkin/openapi-fetch": "file:../../library/openapi-fetch",
		"@types/node": "^25.6.2",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.59.3",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"msw": "^2.15.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"tsc-alias": "^1.9.3",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.6"
	}
}
