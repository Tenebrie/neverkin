# Build stage
FROM node:26-alpine AS builder

WORKDIR /app

# Copy and build ts-shared first
COPY ./app/ts-shared /app/ts-shared
RUN cd /app/ts-shared && npm ci

# Install deps for every local library, build them in dependency order, then prune to production deps
COPY ./library /library
RUN for d in /library/*/; do if [ -f "$d/package.json" ]; then (cd "$d" && npm ci); fi; done && \
	node /library/ci-build.mjs && \
	for d in /library/*/; do if [ -f "$d/package.json" ]; then (cd "$d" && npm prune --omit=dev); fi; done

# Copy package files and install ALL dependencies (needed for build)
COPY ./app/orpheus-mcp/package.json ./app/orpheus-mcp/package-lock.json /app/orpheus/
WORKDIR /app/orpheus
RUN npm ci

# Copy source files and build
COPY ./app/orpheus-mcp /app/orpheus
RUN npm run build

# Production stage
FROM node:26-alpine

WORKDIR /app/orpheus

# Install ONLY production dependencies
COPY --from=builder /app/orpheus/package.json /app/orpheus/package-lock.json /app/orpheus/
COPY --from=builder /library /library
RUN npm ci --omit=dev && npm cache clean --force

# Copy only the built JavaScript and ts-shared source (no node_modules)
COPY --from=builder /app/orpheus/dist /app/orpheus/dist
COPY ./app/ts-shared/package.json /app/ts-shared/package.json
COPY ./app/ts-shared/src /app/ts-shared/src

EXPOSE 3002
