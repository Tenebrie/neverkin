{
	"name": "styx-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"homepage": "https://timelines.tenebrie.com",
	"scripts": {
		"tsc": "tsc --noEmit",
		"build": "tsc --noEmit && rsbuild build",
		"build:ci": "rsbuild build",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"openapi": "npx @rtk-query/codegen-openapi ./openapi/openapi-config.cjs && node ./openapi/post-process.cjs && npx eslint src/api --fix",
		"prune-build-modules": "npm install --omit=dev --ignore-scripts --prefer-offline",
		"start": "CI=true rsbuild dev",
		"test": "rstest",
		"test:watch": "rstest --watch",
		"test:coverage": "rstest --coverage",
		"prod": "serve -s build -l 8080"
	},
	"dependencies": {
