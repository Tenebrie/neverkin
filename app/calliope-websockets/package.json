	"scripts": {
		"tsc": "tsc --noEmit",
		"build": "tsc -p . && tsc-alias -p tsconfig.json",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"prod": "node dist/index.js",
		"prune-build-modules": "npm install --omit=dev --ignore-scripts --prefer-offline",
