		"@tiptap/extension-character-count": "^3.31.4",
		"@tiptap/extension-collaboration": "^3.31.4",
		"@tiptap/extension-color": "^3.31.4",
		"@tiptap/extension-font-family": "^3.31.4",
		"@tiptap/extension-hard-break": "^3.31.3",
		"@tiptap/extension-image": "^3.31.4",
		"@tiptap/extension-mention": "^3.31.4",
		"@tiptap/extension-placeholder": "^3.31.4",
