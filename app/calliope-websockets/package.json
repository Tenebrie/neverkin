		"chalk": "^6.0.1",
		"happy-dom": "^20.14.5",
		"jsonwebtoken": "^9.0.3",
		"koa": "^3.2.1",
		"koa-bodyparser": "^4.4.1",
		"koa-route": "^4.0.1",
		"koa-websocket": "^7.0.0",
		"nodemon": "^3.1.14",
		"openapi-fetch": "^0.17.0",
		"redis": "^6.3.0",
		"ws": "^8.22.0"
