		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-no-relative-import-paths": "^1.7.3",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.9",
		"tsc-alias": "^1.9.7",
