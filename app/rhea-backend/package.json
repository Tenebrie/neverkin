{
	"name": "rhea-backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "",
	"license": "GPL-3.0-or-later",
	"author": "Tenebrie",
	"scripts": {
		"tsc": "tsc --noEmit",
		"build": "prisma generate && tsc -p . && tsc-alias -p tsconfig.json && copyfiles -u 2 src/assets/**/* dist/assets",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"prod": "node dist/src/index.js",
		"prune-build-modules": "npm install --omit=dev --ignore-scripts --prefer-offline",
		"start": "nodemon --watch src $(node /scripts/prepare-library-deps-list.mjs) --ext ts,js,json --ignore 'src/**/*.spec.ts' --exec 'tsx src/index.ts' --delay 0.1s",
		"test": "vitest --run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1124.0",
		"@aws-sdk/s3-presigned-post": "^3.1124.0",
		"@aws-sdk/s3-request-presigner": "^3.1124.0",
		"@google/genai": "^2.20.0",
		"@koa/router": "^15.7.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"bcrypt": "^6.0.0",
		"chalk": "^6.0.0",
		"cheerio": "^1.2.0",
		"fast-average-color-node": "^3.2.0",
		"google-auth-library": "^11.0.2",
		"jsonwebtoken": "^9.0.3",
		"koa": "^3.2.1",
		"koa-bodyparser": "^4.4.1",
		"moonflower": "^1.6.2",
		"redis": "^6.2.1",
		"sharp": "^0.35.4",
		"ws": "^8.21.3",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/koa": "^3.0.3",
		"@types/koa-bodyparser": "^4.3.13",
		"@types/node": "^26.4.1",
		"@types/supertest": "^7.2.1",
		"@types/ws": "^8.18.1",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.59.3",
		"copyfiles": "^2.4.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"jsdom": "^30.0.1",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.6",
		"prisma": "^7.10.0",
		"supertest": "^7.2.2",
		"ts-morph": "^28.0.0",
		"ts-to-zod": "^5.1.0",
		"tsc-alias": "^1.9.3",
		"tsx": "^4.23.13",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
