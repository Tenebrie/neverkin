enum SearchableEntity {
  Actor
  Article
  Folder
  Event
  Tag
  Node
}

view WorldSearchEntry {
  worldId    String
  entityType SearchableEntity
  entityId   String
  pageId     String?
  name       String
  title      String?
  content    String
  timestamp  BigInt?
  createdAt  DateTime
  updatedAt  DateTime
  icon       String
  color      String

  @@unique([worldId, entityType, entityId, pageId])
}
