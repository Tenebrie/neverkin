model Tag {
    id        String   @id @default(uuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt

    name        String
    description String @default("")
    color       String @default("#9f2261")

    mentions    Mention[]        @relation("TagMentionSource")
    mentionedIn Mention[]        @relation("TagMentionTarget")
    assetRefs   AssetReference[] @relation("TagAssetReference")

    nodes MindmapNode[]

    world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
    worldId String

    parentFolder         WikiFolder? @relation("FolderTag", fields: [parentFolderId], references: [id], onDelete: Cascade)
    parentFolderId       String?
    parentFolderPosition Float       @default(0)

    @@index([worldId, parentFolderId])
    @@index([name(ops: raw("gin_trgm_ops")), description(ops: raw("gin_trgm_ops"))], type: Gin)
}
