enum WorldCalendarType {
  COUNTUP
  EARTH
  PF2E
  RIMWORLD
  EXETHER
}

enum WorldAccessMode {
  Private
  PublicRead
  PublicEdit
}

model World {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name        String
  description String             @default("")
  actors      Actor[]
  events      WorldEvent[]
  articles    WikiArticle[]
  folders     WikiFolder[]
  tags        Tag[]
  calendar    WorldCalendarType?
  timeOrigin  BigInt             @default(0)

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId             String
  accessMode          WorldAccessMode      @default(Private)
  collaborators       CollaboratingUser[]
  mindmapNodes        MindmapNode[]
  worldEventTracks    WorldEventTrack[]
  worldCommonIconSets WorldCommonIconSet[]
  savedColors         SavedColor[]
  calendars           Calendar[]
  shareLinks          WorldShareLink[]
  assetReferences     AssetReference[]

  @@index([ownerId])
}

model WorldEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  icon        String  @default("default")
  color       String  @default("#efb45e")
  name        String
  timestamp   BigInt
  revokedAt   BigInt?
  content     String  @default("")
  contentRich String  @default("")

  pages       ContentPage[]    @relation("EventContentPage")
  mentions    Mention[]        @relation("EventMentionSource")
  mentionedIn Mention[]        @relation("EventMentionTarget")
  assetRefs   AssetReference[] @relation("EventAssetReference")

  nodes       MindmapNode[]
  deltaStates WorldEventDelta[]

  world             World            @relation(fields: [worldId], references: [id], onDelete: Cascade)
  track             WorldEventTrack? @relation(fields: [worldEventTrackId], references: [id], onDelete: Cascade)
  worldId           String
  worldEventTrackId String?

  parentFolder         WikiFolder? @relation("FolderEvent", fields: [parentFolderId], references: [id], onDelete: Cascade)
  parentFolderId       String?
  parentFolderPosition Float       @default(0)

  @@index([worldId, parentFolderId])
  @@index([worldEventTrackId])
}

model WorldEventDelta {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  timestamp BigInt

  name            String?
  description     String?
  descriptionRich String?

  worldEventId String
  worldEvent   WorldEvent @relation(fields: [worldEventId], references: [id], onDelete: Cascade)

  @@index([worldEventId, timestamp])
}

model WorldEventTrack {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name     String
  position Int
  visible  Boolean @default(true)

  events WorldEvent[]

  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId String

  @@index([worldId])
}

model WorldShareLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  slug       String             @unique
  label      String?
  expiresAt  DateTime?
  accessMode CollaboratorAccess

  usageCount Int @default(0)

  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId String

  @@index([worldId])
}
