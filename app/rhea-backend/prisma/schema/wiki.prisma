model WikiArticle {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name        String
  icon        String @default("default")
  color       String @default("#3a92e4")
  content     String @default("")
  contentRich String @default("")

  pages       ContentPage[]    @relation("ArticleContentPage")
  mentions    Mention[]        @relation("ArticleMentionSource")
  mentionedIn Mention[]        @relation("ArticleMentionTarget")
  assetRefs   AssetReference[] @relation("ArticleAssetReference")

  nodes MindmapNode[]

  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId String

  parentFolder         WikiFolder? @relation("FolderArticle", fields: [parentFolderId], references: [id], onDelete: Cascade)
  parentFolderId       String?
  parentFolderPosition Float       @default(0)

  @@index([worldId, parentFolderId])
}

model WikiFolder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name  String
  icon  String @default("default")
  color String @default("#9f7eed")

  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId String

  parent               WikiFolder? @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  parentFolderId       String?
  parentFolderPosition Float       @default(0)

  nodes MindmapNode[]

  children WikiFolder[]  @relation("FolderHierarchy")
  articles WikiArticle[] @relation("FolderArticle")
  actors   Actor[]       @relation("FolderActor")
  events   WorldEvent[]  @relation("FolderEvent")
  tags     Tag[]         @relation("FolderTag")

  @@index([worldId, parentFolderId])
}
