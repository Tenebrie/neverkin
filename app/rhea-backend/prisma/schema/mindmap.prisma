model MindmapNode {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name        String @default("")
  content     String @default("")
  contentRich String @default("")
  positionX   Int
  positionY   Int

  parentActor     Actor?       @relation(fields: [parentActorId], references: [id], onDelete: Cascade)
  parentActorId   String?
  parentArticle   WikiArticle? @relation(fields: [parentArticleId], references: [id], onDelete: Cascade)
  parentArticleId String?
  parentEvent     WorldEvent?  @relation(fields: [parentEventId], references: [id], onDelete: Cascade)
  parentEventId   String?
  parentFolder    WikiFolder?  @relation(fields: [parentFolderId], references: [id], onDelete: Cascade)
  parentFolderId  String?
  parentTag       Tag?         @relation(fields: [parentTagId], references: [id], onDelete: Cascade)
  parentTagId     String?

  pages     ContentPage[]    @relation("NodeContentPage")
  mentions  Mention[]        @relation("NodeMentionSource")
  assetRefs AssetReference[] @relation("NodeAssetReference")

  links    MindmapLink[] @relation("MindmapLinkSource")
  linkedBy MindmapLink[] @relation("MindmapLinkTarget")

  world   World  @relation(fields: [worldId], references: [id], onDelete: Cascade)
  worldId String

  @@index([worldId])
  @@index([parentActorId])
  @@index([parentArticleId])
  @@index([parentEventId])
  @@index([parentFolderId])
  @@index([parentTagId])
}

enum MindmapLinkDirection {
  Normal
  Reversed
  TwoWay
}

model MindmapLink {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sourceNode   MindmapNode @relation("MindmapLinkSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  sourceNodeId String

  targetNode   MindmapNode @relation("MindmapLinkTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)
  targetNodeId String

  direction MindmapLinkDirection @default(Normal)
  content   String               @default("")

  @@index([sourceNodeId, targetNodeId])
  @@index([targetNodeId])
}
