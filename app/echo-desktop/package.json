{
	"name": "echo-desktop",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Standalone desktop shell for Neverkin",
	"main": "src/electron-main.cjs",
	"scripts": {
		"build": "node scripts/build-upstream.mjs && node scripts/package.mjs",
