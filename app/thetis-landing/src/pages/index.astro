	<!-- ==================== ABOUT THE DEVELOPER ==================== -->
	<div class="py-16 md:py-20">
		<div class="max-w-5xl mx-auto px-4 sm:px-6">
			<div
				class="flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-12 rounded-xl border border-gray-200 dark:border-slate-700/40 bg-gray-50/50 dark:bg-slate-800/30 p-8 md:p-12 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
			>
				<div class="shrink-0">
					<div
