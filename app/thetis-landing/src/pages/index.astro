---
import Layout from '~/layouts/PageLayout.astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import devPhoto from '~/assets/images/dev-photo.jpg'
import appHero from '~/assets/app-hero.png'
import appHeroLight from '~/assets/app-hero-light.png'
import showcaseDashboard from '~/assets/showcase/app-showcase-01.png'
import showcaseMindmap from '~/assets/showcase/app-showcase-02.png'
import showcaseEditor from '~/assets/showcase/app-showcase-03.png'

import Hero from '~/components/widgets/Hero.astro'
import Features from '~/components/widgets/Features.astro'
import Features2 from '~/components/widgets/Features2.astro'
import FAQs from '~/components/widgets/FAQs.astro'
import Stats from '~/components/widgets/Stats.astro'
import CallToAction from '~/components/widgets/CallToAction.astro'
import Testimonials from '~/components/widgets/Testimonials.astro'
import ShowcaseCarousel from '~/components/widgets/ShowcaseCarousel.astro'

const metadata = {
	title: 'Neverkin — Collaborative Writing & Worldbuilding App for Storytellers',
	ignoreTitleTemplate: true,
	description:
		'Free, open-source collaborative writing and worldbuilding app for storytellers, DMs, writers and novelists. Organize timelines, characters, lore, and interconnected stories online in real-time.',
}

const faqs = [
	{
		title: 'Is Neverkin really free?',
		description:
			"Yes! Neverkin is open-source under the GPL-3.0 license. You can use the hosted version for free, download the desktop version, or self-host it on your own server. You can't pay even if you wanted to. Maybe Patreon at some point in the future.",
	},
	{
		title: 'Can I keep parts of my world private?',
		description:
			'All your data is private by default - nothing is visible to anyone unless you explicitly share it. You can invite collaborators with read-only or editing access, or make a world publicly visible if you choose. If you self-host, then your creativity never leaves your machine.',
	},
	{
		title: 'How does real-time collaboration work?',
		description:
			'When you invite collaborators to your world, they can view or edit based on the permissions you set. All changes sync instantly via WebSockets — every connected user sees updates in real-time.',
	},
	{
		title: 'How does it compare to other worldbuilding apps?',
		description:
			'<b>Ambitiously!</b> Neverkin is still young, but it already delivers a solid set of features that set it apart. Take a look at the <a href="/alternatives" class="text-primary hover:underline">full comparison</a> against the giants like World Anvil, Obsidian and Miro for more details.',
	},
	{
		title: 'Can I export my data from Neverkin?',
		description:
			'Yes! You can export or import your data as a JSON file to back up your worlds or to move them between environments. Other formats are coming... eventually.',
	},
	{
		title: "I'm a developer. Can I contribute?",
		description:
			'I would love that! Neverkin has been built with development experience in mind. Check out the <a href="https://github.com/tenebrie/neverkin" class="text-primary hover:underline">GitHub repository</a> to get started.',
	},
	{
		title: 'I have a question or a suggestion. How do I get in touch?',
		description:
			'Either through the <a href="/contact" class="text-primary hover:underline">contact form</a> or on <a href="https://discord.gg/rD3KdXmqDP" class="text-primary hover:underline">Discord</a>. Trust me, I do read them. On most days, you can expect a response within minutes.',
	},
]

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.title,
		acceptedAnswer: { '@type': 'Answer', text: faq.description },
	})),
}
---

<Layout metadata={metadata}>
	<!-- JSON-LD Structured Data for SEO -->
	<script is:inline type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "Neverkin",
			"applicationCategory": "ProductivityApplication",
			"operatingSystem": "Web, Windows, macOS, Linux",
			"url": "https://neverkin.com",
			"description": "Free, open-source collaborative writing and worldbuilding app for storytellers, DMs, writers and novelists. Organize timelines, characters, lore, and interconnected stories online in real-time.",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"author": {
				"@type": "Person",
				"name": "Maija L.",
				"url": "https://github.com/tenebrie"
			},
			"license": "https://opensource.org/licenses/GPL-3.0"
		}
	</script>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<!-- ==================== HERO ==================== -->
	<Hero
		actions={[
			{
				variant: 'primary',
				text: 'Web Version',
				href: 'https://app.neverkin.com',
				icon: 'tabler:pencil-heart',
			},
			{ text: 'Desktop App', href: '/download', icon: 'tabler:download' },
		]}
	>
		<Fragment slot="title">
			<span class="text-brand-gradient">Worlds</span> for notes and <span class="text-brand-gradient"
				>thoughts</span
			>
		</Fragment>

		<Fragment slot="subtitle">
			<span class="hidden sm:inline">
				<span class="font-semibold text-brand-gradient">Neverkin</span> is a worldbuilding platform for people.</span
			>
			Just write something neat.
		</Fragment>

		<Fragment slot="content">
			<p
				class="mt-6 text-center text-sm text-muted dark:text-slate-400 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
			>
				<a
					href="https://github.com/tenebrie/neverkin"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-primary hover:underline"
				>
					<Icon name="tabler:brand-github" class="w-4 h-4" />
					Grab sources here
				</a>
			</p>
			<div
				class="mt-8 flex justify-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
			>
				<div class="relative w-full max-w-4xl">
					<div class="absolute -inset-3 rounded-3xl bg-purple-600/15 blur-2xl" aria-hidden="true"></div>
					<div
						class="relative rounded-2xl bg-slate-900/5 p-1.5 ring-1 ring-slate-900/10 shadow-2xl shadow-purple-900/30 dark:bg-white/6 dark:ring-white/10"
					>
						<Image
							src={appHero}
							alt="Screenshot of the Neverkin timeline view"
							class="hidden w-full rounded-xl dark:block"
							widths={[640, 1024, 1636, 3272]}
							sizes="(max-width: 1023px) 100vw, 896px"
							loading="eager"
						/>
						<Image
							src={appHeroLight}
							alt="Screenshot of the Neverkin timeline view"
							class="w-full rounded-xl dark:hidden"
							widths={[640, 1024, 1636, 3272]}
							sizes="(max-width: 1023px) 100vw, 896px"
							loading="eager"
						/>
					</div>
				</div>
			</div>
		</Fragment>
		<Fragment slot="bg">
			<div class="absolute inset-0 bg-linear-to-b from-purple-900/20 via-transparent to-transparent"></div>
			<div class="absolute top-0 left-1/2 -translate-x-1/2 w-200 h-150 bg-purple-600/5 rounded-full blur-3xl">
			</div>
		</Fragment>
	</Hero>

	<!-- ==================== STATS / HIGHLIGHTS ==================== -->
	<Stats
		stats={[
			{ title: 'In Development Since', amount: 'Est. 2022', icon: 'tabler:code' },
			{ title: 'No Credit Cards Accepted', amount: '0 Paywalls', icon: 'tabler:heart' },
			{ title: 'Performance Focus', amount: '240+ fps', icon: 'tabler:bolt' },
		]}
	/>

	<!-- ==================== KEY FEATURES ==================== -->
	<Features
		id="features"
		tagline="Key Features"
		title="...and some things that are just neat"
		subtitle="An ever-growing writer's toolkit"
		items={[
			{
				title: 'Wiki & Characters',
				description:
					'Define actors, events and articles, group them into folders and link them all through tags and mentions.',
				icon: 'tabler:book',
			},
			{
				title: 'Real-Time Collaboration',
				description:
					'Invite co-authors and collaborators. Your changes sync live over network - perfect for writing groups and TTRPG tables.',
				icon: 'tabler:arrows-exchange',
			},
			{
				title: 'Map Your Mind',
				description: 'Plot ideas, relationships or dungeon rooms on a visual mindmap.',
				icon: 'tabler:timeline',
			},
			{
				title: 'Interactive Timeline',
				description: 'Plot events on a visual timeline across billions of years.',
				icon: 'tabler:timeline',
			},
			{
				title: 'Custom Calendars',
				description:
					'Earth years too boring? Define your own wild calendar and imaginary time units. Esoteric calendars allowed.',
				icon: 'tabler:calendar',
			},
			{
				title: 'Security & Access Control',
				description:
					'Only you can access your data, unless you choose to share it. It is not harvested or sold to anyone.',
				icon: 'tabler:file-text-shield',
			},
			{
				title: 'AI Integration',
				description:
					'Connect your favorite AI assistant via the built-in MCP server. Let the clankers write down your notes.',
				icon: 'tabler:robot',
			},
			{
				title: 'Free & Open Source',
				description:
					'Developed without a commercial strategy, Neverkin is a tool that was never meant to be a product.',
				icon: 'tabler:lock-open',
			},
		]}
	/>

